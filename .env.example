# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5433/app
APP_URL=http://localhost:5173

# Optional in dev: without SMTP_HOST login links are printed to the API log.
# In production (NODE_ENV=production) the API refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Sign-up stays closed until Robin opens it (README, „Registrierung öffnen“):
# existing accounts log in, new ones only for these comma-separated addresses.
SIGNUP_ALLOWLIST=
# true = everyone may sign up
SIGNUP_OPEN=
# Comma-separated addresses that may invite testers in the app. Never Savor's test account.
ADMIN_EMAILS=

# Optional, for passkeys in the mobile app (README, „Passkeys“): Apple team ID and
# comma-separated SHA-256 fingerprints of the Android signing certificates
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# Optional. App builds below these build numbers (CI run number) must update (README, „Update-Pflicht“).
MIN_BUILD_IOS=
MIN_BUILD_ANDROID=

# Pause between two update mails of the worker (bun run worker in apps/api)
UPDATE_MAIL_INTERVAL_MS=6000

# Optional. Empty DSN = GlitchTip off.
SENTRY_DSN=
