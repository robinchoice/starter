# Environment variables of the Coolify resource.
# IMAGE_PREFIX and IMAGE_TAG are set by the CI on every deploy.

# Public URL without trailing slash
APP_URL=https://example.pleasance.org

# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Memory limit of Postgres, default 512m
POSTGRES_MEMORY=

# Required, the API does not start without SMTP_HOST.
# Proton SMTP: the password is the SMTP token of the sender address.
# Business senders use noreply@pleasance.org, private ones noreply@diespaetzles.lol.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@pleasance.org
SMTP_PASS=CHANGE_ME
EMAIL_FROM=Starter <noreply@pleasance.org>

# Pause between two update mails of the worker, Proton's SMTP limits the rate.
# Default 6000, one mail every 6 seconds.
UPDATE_MAIL_INTERVAL_MS=

# Sign-up stays closed until Robin's go (README, „Registrierung öffnen“):
# existing accounts log in, new ones only for these comma-separated addresses (Robin, testers).
SIGNUP_ALLOWLIST=
# Only after Robin's go: true = everyone may sign up
SIGNUP_OPEN=
# Comma-separated addresses that see „Tester einladen“ in the app and may invite testers.
# robin@pleasance.org is the human admin. Never admin@pleasance.org, the agents' account.
ADMIN_EMAILS=robin@pleasance.org

# Only with a mobile app, for its passkeys (README, „Passkeys“). Team ID of the
# Apple developer account and comma-separated SHA-256 fingerprints (AA:BB:…) of
# Play's app signing key and the upload key. Empty = no app links.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# Only with a mobile app: builds below these build numbers (CI run number) only see the
# update screen. Empty = no minimum. Raise only once a newer build is live in that store
# (README, „Update-Pflicht“).
MIN_BUILD_IOS=
MIN_BUILD_ANDROID=

# Feedback button: reports are mailed here, replies reach the tester.
FEEDBACK_EMAIL=
# Fine-grained GitHub token that may only write issues, from ~/.secrets
# (GITHUB_FEEDBACK_TOKEN). Without it, no issues.
FEEDBACK_GITHUB_TOKEN=

# GlitchTip DSN of this project, used by API, web server and browser
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# PostHog project key (phc_…) of the shared prototypes project. Empty = no analytics.
PUBLIC_POSTHOG_KEY=
