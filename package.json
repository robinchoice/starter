{
  "name": "starter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "check": "biome check && bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "db:generate": "bun run --filter @app/db db:generate",
    "format": "biome check --write",
    "standards": "bun --port 4300 standards/index.html"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
